#!/usr/bin/env python3
import sys, os

# Set process name and terminal title as early as possible so fish's
# fish_title never gets a chance to show "python3".
sys.argv[0] = "ac-ui"
try:
    import ctypes, ctypes.util
    _libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    _libc.prctl(15, b"ac-ui", 0, 0, 0)
except Exception:
    pass
try:
    os.write(sys.stdout.fileno(), b"\033]0;ac-ui\007")
except Exception:
    pass

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ac_ui.ui import main
if __name__ == "__main__":
    main()
